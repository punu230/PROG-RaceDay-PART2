@model RaceDay.MVC.Models.EventDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="img-fluid w-100 rounded shadow-sm mb-4" style="max-height: 400px; object-fit: cover;" alt="@Model.Name" />
    }
    <div class="card shadow border-0 mb-4 bg-light">
        <div class="card-body p-5">
            <h1 class="display-5 fw-bold text-primary">@Model.Name</h1>
            <p class="lead mt-3">@Model.Description</p>
            <hr />
            <div class="row mt-4">
                <div class="col-md-3"><strong>📅 Date:</strong><br /> @Model.Date.ToString("dd MMM yyyy")</div>
                <div class="col-md-3"><strong>📍 Location:</strong><br /> @Model.Location</div>
                <div class="col-md-3"><strong>🏃 Distance:</strong><br /> @Model.Distance km</div>
                <div class="col-md-3"><strong>🏢 Organiser:</strong><br /> @Model.Organiser</div>
            </div>
        </div>
    </div>

    <h3 class="mb-4">Available Categories</h3>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
    }

    @if (Model.Categories == null || Model.Categories.Count == 0)
    {
        <div class="alert alert-warning">No categories have been added to this event yet.</div>
    }
    else
    {
        <div class="row">
            @foreach (var cat in Model.Categories)
            {
                <div class="col-md-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title fw-bold mb-1">@cat.Name</h5>
                                <p class="text-muted mb-0">
                                    @if (!string.IsNullOrEmpty(cat.Gender))
                                    {
                                        <span>@cat.Gender | </span>
                                    }
                                    Ages @cat.MinAge - @cat.MaxAge
                                </p>
                            </div>
                            <div class="text-end">
                                <h4 class="text-success mb-2">R @cat.Fee</h4>
                                <form method="post" asp-action="Enrol">
                                    <input type="hidden" name="categoryId" value="@cat.Id" />
                                    <button type="submit" class="btn btn-primary fw-bold">Enrol Now</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
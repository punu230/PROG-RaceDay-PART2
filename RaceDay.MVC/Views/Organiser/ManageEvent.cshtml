@{
    ViewData["Title"] = "Manage Event";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage: @ViewBag.EventName</h2>
        <div>
            <a href="/Organiser/ViewEnrolments?eventId=@ViewBag.EventId" class="btn btn-primary fw-bold me-2">View Enrolments & Record Results</a>
            <a href="/Organiser/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Add Category</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="AddCategory">
                        <input type="hidden" name="eventId" value="@ViewBag.EventId" />

                        <div class="mb-3">
                            <label class="form-label">Category Name</label>
                            <input type="text" name="name" class="form-control" required placeholder="e.g. Elite Men" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Entry Fee (R)</label>
                            <input type="number" step="0.01" name="entryFee" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Gender (Optional)</label>
                            <select name="gender" class="form-select">
                                <option value="">Open (Any)</option>
                                <option value="M">Male</option>
                                <option value="F">Female</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-success w-100">Add Category</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <h4>Existing Categories</h4>
            @if (ViewBag.Categories == null || ViewBag.Categories.Count == 0)
            {
                <div class="alert alert-warning">No categories yet.</div>
            }
            else
            {
                <ul class="list-group shadow-sm">
                    @foreach (var cat in ViewBag.Categories)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span class="fw-bold">@cat.Name</span>
                            <span class="badge bg-primary rounded-pill">R @cat.Fee</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "My Profile";
    var profile = ViewBag.Profile;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">My Profile</h4>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="bg-secondary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                            @profile.FirstName.Substring(0, 1)@profile.LastName.Substring(0, 1)
                        </div>
                        <h3 class="mt-3">@profile.FirstName @profile.LastName</h3>
                        <p class="text-muted">@profile.Email</p>
                    </div>

                    <hr />

                    <p><strong>Emergency Contact:</strong> @profile.EmergencyContact</p>
                    <p><strong>Medical Conditions:</strong> @profile.MedicalConditions</p>
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <hr />
                    <h5 class="mb-3">Update Details</h5>
                    <form method="post" asp-action="UpdateProfile">
                        <div class="mb-3">
                            <label class="form-label">Emergency Contact Name</label>
                            <input type="text" name="emergencyContactName" class="form-control" value="@profile.EmergencyContact" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Medical Conditions</label>
                            <textarea name="medicalConditions" class="form-control" rows="2">@profile.MedicalConditions</textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
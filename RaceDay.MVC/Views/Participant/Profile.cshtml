@{
    ViewData["Title"] = "My Profile";
    var profile = ViewBag.Profile;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">My Profile</h4>
                </div>
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="bg-secondary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                            @profile.FirstName.Substring(0, 1)@profile.LastName.Substring(0, 1)
                        </div>
                        <h3 class="mt-3">@profile.FirstName @profile.LastName</h3>
                        <p class="text-muted">@profile.Email</p>
                    </div>

                    <hr />

                    <p><strong>Emergency Contact:</strong> @profile.EmergencyContact</p>
                    <p><strong>Medical Conditions:</strong> @profile.MedicalConditions</p>
                </div>
            </div>
        </div>
    </div>
</div>